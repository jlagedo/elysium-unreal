# clangd configuration for the ElysiumUE C++ modules.
#
# The compile database is generated by UnrealBuildTool:
#   Build.bat -Mode=GenerateClangDatabase -project=<abs path>/ElysiumUE.uproject -game ElysiumUEEditor Win64 Development
# UBT writes it to the engine root, so it is copied to this directory afterwards.
CompileFlags:
  CompilationDatabase: .

Index:
  StandardLibrary: No

Diagnostics:
  # UE's generated headers and PCH make include analysis wrong, not merely noisy.
  UnusedIncludes: None
  MissingIncludes: None
