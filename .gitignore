# Unreal Engine generated/intermediate folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/

# Per-user files
*.opensdf
*.sdf
*.sln.docstates
*.VC.db
*.VC.opendb

# Visual Studio / Rider project files (generated)
# .vsconfig is committed on purpose: it pins the VS components a fresh checkout needs.
*.sln
*.slnx
*.suo
*.xcodeproj
*.xcworkspace

# VSCode project files (generated via UBT -vscode; regenerable)
.vscode/
*.code-workspace
compile_commands.json

# JetBrains Rider
.idea/

# Compiled source
*.pyc

# Offline pipeline: generated content + local env (regenerable from the user's install)
tools/out/
tools/.venv/
tools/__pycache__/
tools/models/

# Ghidra: vendored distribution + RE workspace derived from the user's own game
# binaries (bring-your-own, never committed). Only the .java scripts, run.ps1, and
# README under tools/ghidra/ are tracked (see tools/ghidra/.gitignore).
tools/ghidra_12.1.2_PUBLIC/
tools/ghidra/project/
tools/ghidra/out/

# RE reference clones under tools/re/ (read-only, cloned; not ours to ship). The
# tracked scripts there (dll_recon.py, ghidra_extract_mechanics.*) stay committed.
tools/re/out/
# Third-party reference parsers (cloned read-only; used as .mdl layout references).
tools/re/VAMPTools/
tools/re/Crowbar/
# TemplePlus: Troika's Temple of Elemental Evil (2003) reimplementation. Same
# studio one year before VtMB and the same particle-script lineage, so its
# ParticleSystems/ is a readable cross-check on the VtMB engine decompile.
tools/re/TemplePlus/
# Valve's VGUI2 + GameUI sources (sparse checkout) — the menu/scheme/font runtime
# this project ports. VtMBFontEditor is a community .fnt reverse-engineering.
tools/re/source-engine/
tools/re/VtMBFontEditor/

# Precompiled headers / object files
*.pch
*.obj
*.o

# Packaging / cook output
Saved/StagedBuilds/
Saved/Cooked/

# Valve Source SDK sources kept locally as an entity/I-O reverse-engineering
# reference (proprietary, Copyright Valve — never ours to ship or commit).
/sdk/

# OS files
.DS_Store
Thumbs.db
