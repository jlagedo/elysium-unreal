# Unreal Engine generated/intermediate folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/

# Per-user files
*.opensdf
*.sdf
*.sln.docstates
*.VC.db
*.VC.opendb

# Visual Studio / Rider project files (generated)
# .vsconfig is committed on purpose: it pins the VS components a fresh checkout needs.
*.sln
*.slnx
*.suo
*.xcodeproj
*.xcworkspace

# VSCode project files (generated via UBT -vscode; regenerable)
.vscode/
*.code-workspace
compile_commands.json

# JetBrains Rider
.idea/

# Compiled source
*.pyc

# Local path configuration and Python environments
.elysium.local.env
.venv/
*.egg-info/
**/__pycache__/

# Generated or game-derived Unreal packages never belong in Git. Original
# project-authored packages have one explicit Git LFS namespace below.
*.uasset
*.umap
*.ubulk
*.uexp
*.uptnl
*.pak
*.ucas
*.utoc

!Content/ElysiumAuthored/**/*.uasset
!Content/ElysiumAuthored/**/*.umap
!Content/ElysiumAuthored/**/*.ubulk
!Content/ElysiumAuthored/**/*.uexp
!Content/ElysiumAuthored/**/*.uptnl

# Generated project packages. The virtual package paths remain /Game and
# /ElysiumBaked; only their Git posture changes.
Content/ElysiumGenerated/
Content/ElysiumCorpus/
Plugins/ElysiumBaked/Content/

# Pinned third-party plugins are restored by `uv run elysium deps sync`.
Plugins/External/

# Scratch and backup files never carry durable project context.
.codex-patch/
/logs/
/scratch/
*.orig
*.bak
*.pid

# Raw game containers, extracted binaries, and decompiler workspaces belong
# under ELYSIUM_WORK_ROOT, never beside authored project source.
*.bsp
*.mdl
*.phy
*.vpk
*.tth
*.ttz
*.vtf
*.vmt
*.vcd
*.dlg
*.sav
*.gpr
*.gzf
*.gdt
*.dll
*.exe
*.pdb
*.lib
/game/
/extracted/
/decompilation/
/research/evidence/
/research/generated/
/research/captures/
/research/reports/
/research/models/

# Precompiled headers / object files
*.pch
*.obj
*.o

# Packaging / cook output
Saved/StagedBuilds/
Saved/Cooked/

# Build / export logs
*.log

# OS files
.DS_Store
Thumbs.db

# Personal, untracked project memory
CLAUDE.local.md

# clangd background index
.cache/
.pytest_cache/
