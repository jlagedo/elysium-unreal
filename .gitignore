# Unreal Engine generated/intermediate folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/

# Per-user files
*.opensdf
*.sdf
*.sln.docstates
*.VC.db
*.VC.opendb

# Visual Studio / Rider project files (generated)
# .vsconfig is committed on purpose: it pins the VS components a fresh checkout needs.
*.sln
*.slnx
*.suo
*.xcodeproj
*.xcworkspace

# VSCode project files (generated via UBT -vscode; regenerable)
.vscode/
*.code-workspace
compile_commands.json

# JetBrains Rider
.idea/

# Compiled source
*.pyc

# Offline pipeline: generated content + local env (regenerable from the user's install)
tools/out/
tools/.venv/
tools/__pycache__/
tools/models/

# Ghidra + RE workspace: the entire tools/ghidra*/ and tools/re/ trees are local-only
# RE references, never committed. This covers the hand-authored scripts (Dump*.java,
# run.ps1, README, dll_recon.py, ghidra_extract_mechanics.*), the vendored Ghidra
# 12.1.2 distro, the analyzed DB + decompilation dumps derived from the user's own game
# binaries (bring-your-own), and the read-only reference clones (VAMPTools, Crowbar,
# TemplePlus, source-engine, VtMBFontEditor).
tools/ghidra*/
tools/re/

# Precompiled headers / object files
*.pch
*.obj
*.o

# Packaging / cook output
Saved/StagedBuilds/
Saved/Cooked/

# Valve Source SDK sources kept locally as an entity/I-O reverse-engineering
# reference (proprietary, Copyright Valve — never ours to ship or commit).
/sdk/

# OS files
.DS_Store
Thumbs.db
