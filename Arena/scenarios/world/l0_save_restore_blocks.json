    { "t": 2.5, "do": "entity_call", "target": "blockset", "function": "SaveRestore_Restore", "args": [ { "fixture": "blockset" }, 0, 0 ] },
    { "t": 3.0, "do": "entity_call", "target": "patched", "function": "SaveRestore_Save", "args": [ { "fixture": "patched" } ] },
    { "t": 3.5, "do": "entity_call", "target": "patched", "function": "SaveRestore_Restore", "args": [ { "fixture": "patched" }, 0, 0 ] }
