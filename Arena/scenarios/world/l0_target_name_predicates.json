    { "t": 0.64, "do": "entity_call", "target": "Door_A", "function": "HasLinkedDoor", "args": ["Door_B"] },
    { "t": 0.66, "do": "entity_call", "target": "Door_A", "function": "HasLinkedDoor", "args": ["Door_A "] },
