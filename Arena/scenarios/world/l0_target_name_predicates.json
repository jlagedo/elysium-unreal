    { "t": 0.1, "do": "spawn", "row": { "classname": "logic_relay", "name": "Door_A", "at": [50.0, 0.0, 50.0], "keys": { "target": "Door_A" } } },
    { "t": 0.1, "do": "spawn", "row": { "classname": "logic_relay", "name": "NoTarget", "at": [100.0, 0.0, 50.0], "keys": {} } },

