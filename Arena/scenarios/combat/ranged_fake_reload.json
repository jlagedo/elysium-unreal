    },
    {
      "label": "shot_1",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "shot_2",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "shot_3",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "shot_4",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "shot_5",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "shot_6",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "fake_reload",
      "who": "arena_shooter",
      "kind": "schedule",
      "match": "\\(0xc4\\)$",
      "regex": true,
      "within": 6.0
    },
    {
      "label": "reload_in_place",
      "who": "arena_shooter",
      "kind": "schedule",
      "match": "\\(0xc5\\)$",
      "regex": true,
      "within": 8.0
    },
    {
      "label": "reload_clip",
      "who": "arena_shooter",
      "kind": "task",
      "match": "task_play_sequence (",
      "within": 2.0
    },
    {
      "label": "reload_done",
      "who": "arena_shooter",
      "kind": "taskdone",
      "match": "^task_play_sequence$",
      "regex": true,
      "within": 6.0
    },
    {
      "label": "resumes",
      "who": "arena_shooter",
      "kind": "animevent",
      "match": "^3031( |$)",
      "regex": true,
      "within": 10.0
    }
  ],
  "never": [
    {
      "who": "arena_shooter",
      "kind": "cond+",
      "match": "NO_PRIMARY_AMMO (0x40)"
    },
    {
      "who": "arena_shooter",
      "kind": "task",
      "match": "task_reload"
    },
    {
      "who": "arena_shooter",
      "kind": "schedule",
      "match": "\\(0xc[23]\\)$",
      "regex": true
    },
    {
      "who": "arena_shooter",
      "kind": "death"
    }
  ],
  "probes": [
    {
      "at": "end",
      "who": "arena_shooter",
      "probe": "alive",
      "equals": true
    }
  ],
  "notes": "3031 events can emit zero or multiple sets; exact six-set accounting is pinned by Elysium.Arm.Weapons.FakeReloadCountPerSet. ShotFromAnimEvent -> CommitQueuedAttack (0x10238160 -> 0x102387b0) commits the events. Player survival uses retail MakePlayerUnkillable at 0.05."
}
