{
  "name": "ranged_fake_reload",
  "about": "TutorialThug fake-reloads after six bullet sets: loader 0x101d4394..0x101d43c8, reroll 0x102c54c0, per-set decrement 0x10268919, pre-pass 0x102b8620 -> 0xc4 -> no-cover 0xc5. ACT_RELOAD_FAST never runs TASK_RELOAD or spends the clip.",
  "stage": "arena",
  "seed": 1,
  "duration": 60.0,
  "player": {
    "at": "cover_seat"
  },
  "cast": [
    {
      "name": "arena_shooter",
      "classname": "npc_VHumanCombatant",
      "at": "far_ne",
      "face": "player",
      "body": "regular_cop",
      "keys": {
        "stattemplate": "TutorialThug",
        "npc_perception": "3",
        "spawnflags": "4",
        "StartHidden": "0",
        "additionalequipment": "item_w_thirtyeight",
        "player_reaction": "D_HT 5",
        "hint_groups": "2",
        "stay_entrenched": "0",
        "allow_kick_hint_use": "0",
        "squadname": ""
      }
    }
  ],
  "rows": [
    {
      "classname": "events_player",
      "name": "arena_player_events",
      "at": "start"
    }
  ],
  "script": [
    {
      "t": 0.05,
      "do": "fire",
      "target": "arena_player_events",
      "input": "MakePlayerUnkillable"
    }
  ],
  "expect": [
    {
