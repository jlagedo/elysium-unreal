   ShowPinForProperties(23)=(PropertyName="MirrorDataTable",PropertyFriendlyName="Mirror Data Table",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack:MirrorDataTable", "if set and bMirrored MirrorDataTable will be used for mirroring the aniamtion"),CategoryName="Settings",bCanToggleVisibility=True)
