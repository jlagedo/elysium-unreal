   ShowPinForProperties(5)=(PropertyName="StitchBlendMaxCost",PropertyFriendlyName="Stitch Blend Max Cost",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack_Standalone:StitchBlendMaxCost", "if the cost from searching StitchDatabase is above StitchBlendMaxCost, blend stack will perform a regular blend,\nand not using the returned stitch animation as blend"),CategoryName="Stitch|Experimental",bCanToggleVisibility=True)
   ShowPinForProperties(6)=(PropertyName="MaxActiveBlends",PropertyFriendlyName="Max Active Blends",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack_Standalone:MaxActiveBlends", "Number of max active blending animation in the blend stack. If MaxActiveBlends is zero then blend stack is disabled"),CategoryName="Settings")
   ShowPinForProperties(7)=(PropertyName="bStoreBlendedPose",PropertyFriendlyName="Store Blended Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack_Standalone:bStoreBlendedPose", "if the number of requested blends is higher than MaxActiveBlends, blend stack will blend and accumulate\ninto a stored pose all the overflowing animations. if bStoreBlendedPose is false, the memory to store the pose will be saved,\nbut once reached the MaxActiveBlends, blendstack will start discarding animations, potentially resulting in animation pops"),CategoryName="Settings")
   ShowPinForProperties(8)=(PropertyName="NotifyRecencyTimeOut",PropertyFriendlyName="Notify Recency Time Out",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack_Standalone:NotifyRecencyTimeOut", "Window of time after firing a notify that any instance of the same notify will be filtered out."),CategoryName="Settings",bCanToggleVisibility=True)
   ShowPinForProperties(9)=(PropertyName="MaxBlendInTimeToOverrideAnimation",PropertyFriendlyName="Max Blend in Time to Override Animation",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack_Standalone:MaxBlendInTimeToOverrideAnimation", "if the most relevant (recently added) animation is within MaxBlendInTimeToOverrideAnimation, the new requested blend will take its spot\notherwise a new blended will be added to the stack"),CategoryName="Settings")
