   ShowPinForProperties(4)=(PropertyName="LayerSetup",PropertyFriendlyName="Layer Setup",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:LayerSetup", "Configuration for the parts of the skeleton to blend for each layer. Allows\ncertain parts of the tree to be blended out or omitted from the pose.\nLayerSetup is used when BlendMode is BranchFilter."),CategoryName="Config")
   ShowPinForProperties(5)=(PropertyName="BlendWeights",PropertyFriendlyName="Blend Weights",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BlendWeights", "The weights of each layer"),CategoryName="Runtime",bShowPin=True,bCanToggleVisibility=True)
   ShowPinForProperties(6)=(PropertyName="LODThreshold",PropertyFriendlyName="LOD Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:LODThreshold", "Max LOD that this node is allowed to run\nFor example if you have LODThreshold to be 2, it will run until LOD 2 (based on 0 index)\nwhen the component LOD becomes 3, it will stop update/evaluate\ncurrently transition would be issue and that has to be re-visited"),CategoryName="Performance")
   ShowPinForProperties(7)=(PropertyName="bMeshSpaceRotationBlend",PropertyFriendlyName="Mesh Space Rotation Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bMeshSpaceRotationBlend", "Whether to blend bone rotations in mesh space or in local space"),CategoryName="Config")
   ShowPinForProperties(8)=(PropertyName="bRootSpaceRotationBlend",PropertyFriendlyName="Root Space Rotation Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bRootSpaceRotationBlend", "Whether to blend bone rotations in root space or in mesh space"),CategoryName="Config",bHasOverridePin=True)
