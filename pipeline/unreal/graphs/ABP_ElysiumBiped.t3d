   ShowPinForProperties(18)=(PropertyName="MaxAnimationDeltaTime",PropertyFriendlyName="Max Animation Delta Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack:MaxAnimationDeltaTime", "if MaxAnimationDeltaTime is positive and the currently playing animation accumulated time differs more than MaxAnimationDeltaTime from AnimationTime\n(animation desynchronized from the requested time) this blend stack will force a blend into the same animation"),CategoryName="Settings",bCanToggleVisibility=True)
