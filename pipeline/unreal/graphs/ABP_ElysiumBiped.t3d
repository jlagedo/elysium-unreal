   ShowPinForProperties(12)=(PropertyName="AnimationTime",PropertyFriendlyName="Animation Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack:AnimationTime", "requested animation time"),CategoryName="Settings",bCanToggleVisibility=True)
