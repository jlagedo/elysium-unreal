   ShowPinForProperties(25)=(PropertyName="bForceBlendTo",PropertyFriendlyName="Force Blend To",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack:bForceBlendTo", "in case there\'re no blend to the current frame, this blend stack will force a blend to into the currently playing animation.\nuseful to blend into the same animation in case this blendstack synch properties are set to be a follower"),CategoryName="Experimental",bCanToggleVisibility=True)
   ShowPinForProperties(26)=(PropertyName="bUseInertialBlend",PropertyFriendlyName="Use Inertial Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendStack:bUseInertialBlend", "Enable to use inertial blending"),CategoryName="Settings")
