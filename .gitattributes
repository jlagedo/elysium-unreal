# Text files are LF in the index and the working tree on every platform, so exact-match
# edits never trip on a stray CRLF. Git's binary detection still leaves binaries alone.
* text=auto eol=lf

# Windows batch files must be CRLF: cmd.exe seeks by byte offset assuming \r\n,
# so an LF-only .bat is parsed with drifting offsets and leading characters are lost.
*.bat text eol=crlf
*.cmd text eol=crlf

# Patch payloads preserve upstream indentation and blank context verbatim.
*.patch -whitespace

# Original project-authored Unreal packages only. Generated and game-derived
# packages remain prohibited regardless of Git LFS.
Content/ElysiumAuthored/**/*.uasset filter=lfs diff=lfs merge=lfs -text
Content/ElysiumAuthored/**/*.umap filter=lfs diff=lfs merge=lfs -text
Content/ElysiumAuthored/**/*.ubulk filter=lfs diff=lfs merge=lfs -text
Content/ElysiumAuthored/**/*.uexp filter=lfs diff=lfs merge=lfs -text
Content/ElysiumAuthored/**/*.uptnl filter=lfs diff=lfs merge=lfs -text

# Committed movement-gym baselines are compared byte-for-byte against a fresh run,
# so a checkout that rewrote their line endings would turn every bracket red.
dev/baselines/move/** text eol=lf

# Story-5 acceptance pins these authored decisions by byte hash.
docs/specs/0019-npc-kernel-rework/story-5/decisions.json text eol=lf
docs/specs/0019-npc-kernel-rework/story-5/field-decisions.tsv text eol=lf
