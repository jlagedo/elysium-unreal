{
  "schema": 1,
  "run": {
    "harness": "move",
    "host": "gym",
    "course": "gap_128",
    "baseline": "deferred",
    "hz": 60.000000,
    "fixedStep": 0.000000,
    "constants": {
      "StepSize": 18.000000,
      "JumpBoost": 25.000000,
      "JumpBoostScale": 0.990000,
      "StandableZ": 0.700000,
      "StandHeight": 72.000000,
      "DuckHeight": 36.000000,
      "HullHalfWidth": 15.999999,
      "BaseJumpVelocity": 185.000000,
      "JumpHoldTime": 0.200000,
      "JumpGravityMultiplier": 0.750000,
      "Gravity": 800.000000,
      "Friction": 4.000000,
      "StopSpeed": 15.999999,
      "Accelerate": 10.000000,
      "WalkSpeed": 100.000000,
      "RunSpeed": 225.000000
    },
    "tuningOverrides": {}
  },
  "channels": [
    { "name": "frame", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "sample index within the course" },
    { "name": "seq", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "the replayed user command's sequence number" },
    { "name": "dt", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 0.000001, "precision": 6, "unit": "s", "speedDependent": true, "help": "the step the frame was integrated at" },
    { "name": "px", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 0.500000, "precision": 4, "unit": "u", "speedDependent": true, "help": "origin X" },
    { "name": "py", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 0.500000, "precision": 4, "unit": "u", "speedDependent": true, "help": "origin Y" },
    { "name": "pz", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 0.250000, "precision": 4, "unit": "u", "speedDependent": true, "help": "origin Z" },
    { "name": "vx", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 2.000000, "precision": 4, "unit": "u/s", "speedDependent": true, "help": "velocity X" },
    { "name": "vy", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 2.000000, "precision": 4, "unit": "u/s", "speedDependent": true, "help": "velocity Y" },
    { "name": "vz", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 2.000000, "precision": 4, "unit": "u/s", "speedDependent": true, "help": "velocity Z" },
    { "name": "speed2d", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 2.000000, "precision": 4, "unit": "u/s", "speedDependent": true, "help": "horizontal speed" },
    { "name": "onground", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "CategorizePosition's answer" },
    { "name": "ducked", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "the hull is the small one" },
    { "name": "ducking", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "a duck transition is in flight" },
    { "name": "canunduck", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "the standing hull would fit here" },
    { "name": "water", "producer": "move", "scope": "frame", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": true, "help": "EElysiumWaterLevel" },
    { "name": "surffric", "producer": "move", "scope": "frame", "kind": "numeric", "tolerance": 0.010000, "precision": 3, "unit": "", "speedDependent": true, "help": "the ground surface's friction scale" },
    { "name": "move_yaw_wish", "producer": "anim", "scope": "frame", "kind": "angle", "tolerance": 1.000000, "precision": 3, "unit": "deg", "speedDependent": true, "help": "the commanded direction, relative to facing" },
    { "name": "move_yaw_vel", "producer": "anim", "scope": "frame", "kind": "angle", "tolerance": 1.000000, "precision": 3, "unit": "deg", "speedDependent": true, "help": "the realized velocity's direction, relative to facing" },
    { "name": "frames", "producer": "move", "scope": "run", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": false, "help": "how many samples the course produced", "value": 240 },
    { "name": "advance_max", "producer": "move", "scope": "run", "kind": "numeric", "tolerance": 0.500000, "precision": 3, "unit": "u", "speedDependent": false, "help": "furthest distance reached along the start heading", "value": 271.974 },
    { "name": "top_stand", "producer": "move", "scope": "run", "kind": "numeric", "tolerance": 0.250000, "precision": 3, "unit": "u", "speedDependent": false, "help": "highest the feet stood, above the start", "value": 0.000 },
    { "name": "reach_max", "producer": "move", "scope": "run", "kind": "numeric", "tolerance": 0.250000, "precision": 3, "unit": "u", "speedDependent": false, "help": "highest the feet reached at all, above the start", "value": 0.000 },
    { "name": "peak_rise", "producer": "move", "scope": "run", "kind": "numeric", "tolerance": 0.250000, "precision": 3, "unit": "u", "speedDependent": false, "help": "highest rise above a takeoff, per airborne span", "value": 84.944 },
    { "name": "ground_transitions", "producer": "move", "scope": "run", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": false, "help": "how many times the ground state flipped", "value": 4 },
    { "name": "ended_ducked", "producer": "move", "scope": "run", "kind": "exact", "tolerance": 0.000000, "precision": 0, "unit": "", "speedDependent": false, "help": "the body was still ducked on the last frame", "value": 0 },
    { "name": "peak_speed2d", "producer": "move", "scope": "run", "kind": "numeric", "tolerance": 2.000000, "precision": 3, "unit": "u/s", "speedDependent": true, "help": "fastest horizontal speed reached", "value": 225.000 }
  ]
}
